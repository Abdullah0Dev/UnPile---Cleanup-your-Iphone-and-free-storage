{
  "expo": {
    "name": "UnPile",
    "slug": "unpile",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "unpile",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/images/icon.png",
      "backgroundColor": "#08071A",
      "bundleIdentifier": "com.unpile",
      "supportsTablet": false,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },

    "locales": {
      "en": "./src/i18n/native/en.json",
      "fr": "./src/i18n/native/fr.json",
      "de": "./src/i18n/native/de.json",
      "es": "./src/i18n/native/es.json",
      "ar": "./src/i18n/native/ar.json",
      "ja": "./src/i18n/native/ja.json",
      "tr": "./src/i18n/native/tr.json"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08071A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300
        }
      ],

      "expo-image",

      [
        "expo-image-picker",
        {
          "photosPermission": "UnPile needs access to your photo library to scan for duplicates, blurry images, and clutter so you can review and delete them."
        }
      ],

      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "ar", "de", "es", "fr", "ja", "tr"],
            "android": ["en", "ar", "de", "es", "fr", "ja", "tr"]
          },
          "supportsRTL": true
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "android": {
      "package": "com.unpile"
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "5d670618-2fd4-48d0-9601-268444d39016"
      }
    }
  }
}
